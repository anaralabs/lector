{
	"name": "@anaralabs/lector",
	"version": "0.0.0-semantically-released",
	"description": "A headless PDF viewer for React",
	"author": "andrewdr (https://github.com/andrewdoro)",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./esm-only.cjs"
		}
	},
	"files": [
		"dist",
		"esm-only.cjs"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "tsup --watch --onSuccess 'yalc push'",
		"prebuild": "rm -rf dist",
		"build": "tsup",
		"lint": "biome check .",
		"format": "biome format --write .",
		"postbuild": "size-limit --json > size.json",
		"test": "pnpm run '/^test:/'",
		"test:unit": "vitest run --config vitest.unit.config.ts",
		"test:size": "size-limit",
		"prepack": "./scripts/prepack.sh",
		"prepare": "tsup",
		"test:browser": "vitest run",
		"test:package": "node scripts/check-package.mjs",
		"test:types": "tsc --noEmit",
		"bench:corpus": "vitest run --config vitest.bench.config.ts",
		"bench:second-pass": "vitest run tests/annotations.browser.test.tsx tests/thumbnails.browser.test.tsx tests/long-document.browser.test.tsx tests/search-async.browser.test.tsx tests/highlight-stream.browser.test.tsx",
		"bench:performance": "vitest run tests/performance.browser.test.tsx tests/observers.browser.test.tsx tests/extraction.browser.test.tsx tests/document.browser.test.tsx tests/pages.browser.test.tsx"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.48.1",
		"@size-limit/preset-small-lib": "^11.1.6",
		"@testing-library/react": "^16.0.0",
		"@types/node": "^22.9.0",
		"@types/react": "^19.0.1",
		"@types/react-dom": "^19.0.2",
		"@use-gesture/react": "^10.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"clsx": "^2.1.1",
		"pdfjs-dist": "^5.5.207",
		"playwright": "^1.55.1",
		"react": "^19.1.1",
		"size-limit": "^11.1.6",
		"tsc-alias": "^1.8.10",
		"tslib": "^2.6.3",
		"tsup": "^8.3.5",
		"typescript": "^5.5.3",
		"vite": "^6.4.3",
		"vitest": "4.1.11",
		"@vitest/browser-playwright": "4.1.11"
	},
	"peerDependencies": {
		"pdfjs-dist": "^5.5.207",
		"react": ">=19"
	},
	"dependencies": {
		"@floating-ui/react": "^0.26.28",
		"@radix-ui/react-slot": "^1.1.0",
		"@tanstack/react-virtual": "^3.10.9",
		"react-dom": "^19.1.1",
		"use-debounce": "^10.0.4",
		"uuid": "^11.1.1",
		"zustand": "^5.0.2"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "^4.28.1"
	},
	"keywords": [
		"pdf",
		"react",
		"headless",
		"viewer",
		"react-pdf",
		"anaralabs",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anaralabs/lector.git",
		"directory": "packages/lector"
	},
	"bugs": {
		"url": "https://github.com/anaralabs/lector/issues"
	},
	"homepage": "https://github.com/anaralabs/lector",
	"size-limit": [
		{
			"name": "Client",
			"path": "dist/index.js",
			"limit": "150 kB",
			"ignore": [
				"react"
			]
		}
	]
}
